<Window x:Class="CosTest.ToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:CosTest"
        mc:Ignorable="d"
        Title="调试工具" Height="600" Width="1000" WindowStyle="None" HorizontalAlignment="Center" WindowStartupLocation="CenterScreen" AllowsTransparency="True" Icon="/Resources/Vsstec.ico">
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="ResizeMode" Value="CanResize" />
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome CaptionHeight="0" ResizeBorderThickness="20" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Style>
    <Border Margin="0"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="0"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10"
                              Direction="0"
                              ShadowDepth="0" />
        </Border.Effect>
        <Grid>
            <!--定义了2行-->
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="100*"/>
            </Grid.RowDefinitions>
            <!--标题栏-->
            <Grid x:Name="gridCaption" Grid.Row="0" MouseLeftButtonDown="gridCaption_MouseLeftButtonDown" Background="#FF1565C0">
                <Image x:Name="image" Source="/Resources/Tool.png" HorizontalAlignment="Left" Height="40" Width="40" Margin="10,0,0,0"  VerticalAlignment="Center"/>
                <TextBlock Text="调试工具" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="75,0,0,0" FontSize="21.333" Foreground="White"/>
                <Button x:Name="buttonClose" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource CloseGeometry}" Padding="4" ToolTip="关闭" Width="24" Height="24" Margin="5,0,10,0" Click="buttonClose_Click" HorizontalAlignment="Right"/>
            </Grid>
            <!--主界面-->
            <Grid Grid.Row="1" Margin="2,10,2,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60*"/>
                    <ColumnDefinition Width="120*"/>
                </Grid.ColumnDefinitions>
                <!--基本控制-->
                <StackPanel Grid.Column="0">
                    <!--马达运动-->
                    <Expander Grid.Column="0" Header="运动控制">
                        <StackPanel>
                            <GroupBox Header ="IO状态" Style="{StaticResource BaseStyle}" BorderThickness="0" Margin="0,5,0,0">
                                <UniformGrid Columns="2" Margin="10,10,0,0">
                                    <CheckBox Content="马达使能" IsChecked="{Binding ENBL}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,5"/>
                                    <CheckBox Content="马达报警" IsChecked="{Binding ALARM}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,5"/>
                                    <CheckBox Content="Y轴运动" IsChecked="{Binding MOVE}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,5"/>
                                    <CheckBox Content="Y轴复位" IsChecked="{Binding HOME}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,5"/>
                                    <CheckBox Content="门锁" IsChecked="{Binding LOCK}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,5"/>
                                    <CheckBox Content="反射镜" IsChecked="{Binding MIRROR}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,5"/>
                                </UniformGrid>
                            </GroupBox>

                            <GroupBox Header ="马达运动" Style="{StaticResource BaseStyle}" BorderThickness="0" Margin="0,5,0,0">
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30*"/>
                                        <ColumnDefinition Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <UniformGrid Columns="1">
                                        <Button x:Name="btnJogShutterUp" Content="Y+" Background="{Binding JogShutterUpBrush}" Height="30" Width="40" Foreground="Brown" FontWeight="Bold" BorderBrush="Brown" MouseLeave="btnJOG_MouseLeave" PreviewMouseDown="btnJOG_MouseDown" PreviewMouseUp="btnJOG_MouseUp"/>
                                        <Button x:Name="btnJogStop" Content="停止" ToolTip="停止点动" HorizontalAlignment="Center" VerticalAlignment="Center" Background="OrangeRed" Click="btnJogStop_Click" Height="30" Width="40" Padding="5,3,5,3"/>
                                        <Button x:Name="btnJogShutterDown" Content="Y-"  Background="{Binding JogShutterDownBrush}" Height="30" Width="40" Foreground="Brown" FontWeight="Bold" BorderBrush="Brown" MouseLeave="btnJOG_MouseLeave" PreviewMouseDown="btnJOG_MouseDown" PreviewMouseUp="btnJOG_MouseUp"/>
                                    </UniformGrid>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2,0,2">
                                            <TextBlock x:Name="tbPositionY"  Text="Y实际位置" VerticalAlignment="Center" Foreground="ForestGreen"/>
                                            <TextBox Width="50" Text="{Binding POSY}" Margin="4,0,4,0"  Foreground="ForestGreen"/>
                                            <TextBlock Text="(mm)" VerticalAlignment="Center" Foreground="ForestGreen"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2,0,2" >
                                            <TextBlock Text="Y设定速度" VerticalAlignment="Center" Foreground="Brown"/>
                                            <TextBox Width="50" Text="{Binding JogSpeedY}" Margin="4,0,4,0"  Foreground="Brown"/>
                                            <TextBlock Text="(mm/s)" VerticalAlignment="Center" Foreground="Brown"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2,0,2">
                                            <TextBlock Text="Y设定位置" VerticalAlignment="Center" Foreground="Brown"/>
                                            <TextBox Width="50" Text="{Binding TargetPositionY}" Margin="4,0,4,0"  Foreground="Brown"/>
                                            <TextBlock Text="(mm)" VerticalAlignment="Center" Foreground="Brown"/>
                                            <Button x:Name="buttonMoveToPositionY" ToolTip="移动到目标位置" HorizontalAlignment="Center"  Style="{StaticResource ButtonIconCircular}" hc:IconElement.Geometry="{StaticResource StarGeometry}" Padding="6" Background="{StaticResource WarningBrush}" Click="buttonMoveToPositionZ_Click" Width="24" Height="24" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                </Grid>
                            </GroupBox>
                            <GroupBox Header ="常用动作" Style="{StaticResource BaseStyle}" VerticalAlignment="Bottom" BorderThickness="0" Margin="0,5,0,0">
                                <UniformGrid Columns="2" Margin="10,10,0,0">
                                    <Button x:Name="buttonPowerOn" Style="{StaticResource ButtonSuccess}"  Content="启动马达"  Margin="5" Width="80" Click="buttonPowerOn_Click"/>
                                    <Button x:Name="buttonPowerOff" Style="{StaticResource ButtonSuccess}"  Content="关闭马达"  Margin="5" Width="80" Click="buttonPowerOff_Click"/>
                                    <Button x:Name="buttonHome" Style="{StaticResource ButtonSuccess}"  Content="复位Y轴" Margin="5" Width="80" ToolTip="复位X轴马达" Click="buttonHome_Click"/>
                                    <Button x:Name="buttonStopMotion" Style="{StaticResource ButtonSuccess}"  Content="停止运动"  Margin="5" Width="80" Click="buttonStopMotion_Click"/>
                                    <Button x:Name="buttonLock" Style="{StaticResource ButtonSuccess}"  Content="强制锁门"  Margin="5" Width="80" Click="buttonLock_Click"/>
                                    <Button x:Name="buttonUnlock" Style="{StaticResource ButtonSuccess}"  Content="取消锁门"  Margin="5" Width="80" Click="buttonUnlock_Click"/>
                                    <Button x:Name="buttonMirrorIn" Style="{StaticResource ButtonSuccess}"  Content="加载反射镜"  Margin="5" Width="80" Click="buttonMirrorIn_Click" />
                                    <Button x:Name="buttonMirrorOut" Style="{StaticResource ButtonSuccess}"  Content="移开反射镜"  Margin="5" Width="80" Click="buttonMirrorOut_Click" />
                                </UniformGrid>
                            </GroupBox>
                        </StackPanel>
                    </Expander>
                    <!--温度控制-->
                    <Expander Grid.Column="1" Header="温度控制"  Margin="0,10,0,0">
                        <StackPanel>
                            <GroupBox Header ="实时参数" Style="{StaticResource BaseStyle}" BorderThickness="0" Margin="0,5,0,0">
                                <UniformGrid Columns="2" Margin="10,10,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,5">
                                        <TextBlock Text="  电流 " VerticalAlignment="Center"/>
                                        <TextBox Width="50" Text="{Binding IGET}" Margin="4,0,4,0" IsReadOnly="True"/>
                                        <TextBlock Text="(A)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,5">
                                        <TextBlock Text="  电压 " VerticalAlignment="Center"/>
                                        <TextBox Width="50" Text="{Binding VGET}" Margin="4,0,4,0" IsReadOnly="True"/>
                                        <TextBlock Text="(V)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,5">
                                        <TextBlock Text="  温度 " VerticalAlignment="Center"/>
                                        <TextBox Width="50" Text="{Binding TGET}" Margin="4,0,4,0" IsReadOnly="True"/>
                                        <TextBlock Text="(degC)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,5">
                                        <TextBlock Text="  输出使能" VerticalAlignment="Center"/>
                                        <CheckBox IsChecked="{Binding TOUT}" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                            </GroupBox>

                            <GroupBox Header ="输出控制" Style="{StaticResource BaseStyle}" BorderThickness="0" Margin="0,5,0,0">
                                <StackPanel Margin="10,10,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,2">
                                        <TextBlock Text="  目标值 " VerticalAlignment="Center"/>
                                        <TextBox Width="50" Text="{Binding TSET}" Margin="4,0,4,0" />
                                        <TextBlock Text="(degC)" VerticalAlignment="Center"/>
                                        <Button x:Name="buttonJigTempSet" ToolTip="设置温度" HorizontalAlignment="Center" Style="{StaticResource ButtonIconCircular}" hc:IconElement.Geometry="{StaticResource DownloadGeometry}" Padding="8" Background="{StaticResource WarningBrush}" Click="buttonJigTempSet_Click" Margin="20,0,0,0"/>
                                    </StackPanel>
                                    <UniformGrid Columns="2" Margin="0,5,0,0">
                                        <Button x:Name="buttonJigTempOutputOn" Style="{StaticResource ButtonSuccess}"  Content="使能输出"  Margin="5,5,0,5" Width="70" Click="buttonJigTempOutputOn_Click"/>
                                        <Button x:Name="buttonJigTempOutputOff" Style="{StaticResource ButtonSuccess}"  Content="关闭输出"  Margin="5,5,0,5" Width="70" Click="buttonJigTempOutputOff_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Expander>
                    <!--电源控制-->
                    <Expander Grid.Column="1" Header="电源控制"  Margin="0,10,0,0">
                        <StackPanel>
                            <GroupBox Header ="实时参数" Style="{StaticResource BaseStyle}" BorderThickness="0" Margin="0,5,0,0">
                                <UniformGrid Columns="2" Margin="10,10,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
                                        <TextBlock Text="电流" VerticalAlignment="Center" Width="30"/>
                                        <TextBox Width="50" IsReadOnly="True" Text="{Binding CosCurrent,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,5,0"/>
                                        <TextBlock Text="(A)" VerticalAlignment="Center" Width="20"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
                                        <TextBlock Text="电压" VerticalAlignment="Center" Width="30"/>
                                        <TextBox Width="50" IsReadOnly="True" Text="{Binding CosVoltage,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,5,0"/>
                                        <TextBlock Text="(V)" VerticalAlignment="Center" Width="20"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
                                        <TextBlock Text="功率" VerticalAlignment="Center" Width="30"/>
                                        <TextBox Width="50" IsReadOnly="True" Text="{Binding CosPower,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,5,0"/>
                                        <TextBlock Text="(W)" VerticalAlignment="Center" Width="20"/>
                                    </StackPanel>
                                </UniformGrid>
                            </GroupBox>

                            <GroupBox Header ="输出控制" Style="{StaticResource BaseStyle}" BorderThickness="0" Margin="0,5,0,0">
                                <StackPanel    Margin="10,10,0,0">
                                    <ToggleButton x:Name="tbnON" Content="ON" HorizontalAlignment="Left" Style="{StaticResource ToggleButtonSwitch}" IsEnabled="{Binding PINDOWN}" Width="80" Unchecked="tbnON_Unchecked" Checked="tbnON_Checked"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,12,0,2">
                                        <StackPanel Orientation="Horizontal"  HorizontalAlignment="Center" Margin="10,0,30,0">
                                            <TextBlock Text="电流" VerticalAlignment="Center"/>
                                            <TextBox Width="60" Margin="2,0,2,0" IsEnabled="{Binding IsCosOn}"  Text="{Binding CosCurrentSet}"/>
                                            <TextBlock Text="(A)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"  HorizontalAlignment="Center">
                                            <TextBlock Text="电压" VerticalAlignment="Center"/>
                                            <TextBox Width="60" Margin="2,0,2,0" IsEnabled="{Binding IsCosOn}"  Text="{Binding CosVoltageSet}"/>
                                            <TextBlock Text="(V)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button x:Name="btnSetCurrent" ToolTip="更新电流值" HorizontalAlignment="Center"  IsEnabled="{Binding IsCosOn}" Style="{StaticResource ButtonIconCircular}" hc:IconElement.Geometry="{StaticResource DownloadGeometry}" Padding="8" Background="{StaticResource WarningBrush}" Click="btnSetCurrent_Click" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <!--数据扫描-->
                <TabControl  Grid.Column="1" Margin="10,0,2,0">
                    <!--LIV扫描-->
                    <TabItem Background="{StaticResource BackgroundBrush}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Margin="5,0,5,0">
                                <Image Source="/Resources/LIV.png" Width="20" Height="20" VerticalAlignment="Center" Stretch="Fill"/>
                                <TextBlock Text="LIV扫描" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <!--定义了2行-->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>
                            <!--LIV图-->
                            <lvc:CartesianChart  Grid.Column="0" Margin="5" lvc:DisableAnimations="True" Series="{Binding LivSeries}"  DataTooltip="{Binding LivToolTip}" LegendLocation="Top">
                                <!--X坐标轴-->
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="Current" MinValue="0" MaxValue="{Binding LivChartCurrentStop}"  LabelFormatter="{Binding Formatter}" Foreground="Black" FontSize="14">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="True" Step="{Binding LivChartCurrentStep}" StrokeThickness="1" Stroke="Pink"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <!--Y坐标轴-->
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis  Title="Power" Position="LeftBottom" MinValue="0" MaxValue="{Binding LivChartPowerUCL}"  LabelFormatter="{Binding Formatter}" Foreground="Black" FontSize="14">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="True" Step="{Binding LivChartPowerStep}"  StrokeThickness="1" Stroke="Pink"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                    <lvc:Axis  Title="Voltage" Position="RightTop" MinValue="0" MaxValue="{Binding LivChartVoltageUCL}" LabelFormatter="{Binding Formatter}" Foreground="Blue" FontSize="14">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="True" Step="{Binding LivChartVoltageStep}" StrokeThickness="1" Stroke="Pink"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                            <!--控制-->
                            <StackPanel Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" Orientation="Horizontal">
                               
                                    <Button x:Name="buttonLivTest" Style="{StaticResource ButtonSuccess}" IsEnabled="{Binding PINDOWN}"  Content="LIV测试"   Width="80" Click="buttonLivTest_Click"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text=" 基准" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <ComboBox Style="{StaticResource ComboBoxBaseStyle}" ItemsSource="{Binding SpWavelengthBaseList}" SelectedItem="{Binding SpWavelengthBase}" BorderThickness="1" Width="60" HorizontalAlignment="Center" Margin="5,0,5,0" Padding="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" SelectionChanged="cbSpWavelengthBaseList_SelectionChanged"/>
                                        <TextBlock Text="(nm)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"   Margin="10,0,0,0">
                                        <TextBlock Text="预加载电压" VerticalAlignment="Center"/>
                                        <TextBox Width="40"  Text="{Binding PreloadingVoltage}"/>
                                        <TextBlock Text="(V)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                <StackPanel Orientation="Horizontal"    Margin="10,0,0,0">
                                        <TextBlock Text="结束" VerticalAlignment="Center"/>
                                        <TextBox Width="40"  Text="{Binding LivStop}"/>
                                        <TextBlock Text="(A)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                <StackPanel Orientation="Horizontal"    Margin="10,0,0,0">
                                        <TextBlock Text="步进" VerticalAlignment="Center"/>
                                        <TextBox Width="40"  Text="{Binding LivStep}"/>
                                        <TextBlock Text="(A)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                <StackPanel Orientation="Horizontal"   Margin="10,0,0,0">
                                        <TextBlock Text="延时" VerticalAlignment="Center"/>
                                        <TextBox Width="40"  Text="{Binding LivDelay}"/>
                                        <TextBlock Text="(ms)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <!--光谱扫描-->
                    <TabItem Background="{StaticResource BackgroundBrush}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Margin="5,0,5,0">
                                <Image Source="/Resources/Spectrum.png" Width="20" Height="20" VerticalAlignment="Center" Stretch="Fill"/>
                                <TextBlock Text="光谱扫描" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="17*"/>
                                <ColumnDefinition Width="200*"/>
                            </Grid.ColumnDefinitions>
                            <!--定义了2行-->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="110"/>
                            </Grid.RowDefinitions>
                            <!--光谱图-->
                            <lvc:CartesianChart Margin="5,5,5,5" lvc:DisableAnimations="True" Series="{Binding SpectrumSeries}" DataTooltip="{Binding SpToolTip}" LegendLocation="Top" Grid.ColumnSpan="2">
                                <!--X坐标轴-->
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="Wavelength" MinValue="{Binding SpChartWavelengthLCL}" MaxValue="{Binding SpChartWavelengthUCL}" LabelFormatter="{Binding Formatter}" Foreground="Black" FontSize="14">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="True" Step="{Binding SpChartWavelengthStep}" StrokeThickness="1" Stroke="Pink"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <!--Y坐标轴-->
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis  Title="Spectrum" MinValue="0" MaxValue="{Binding SpChartSpectrumUCL}" LabelFormatter="{Binding Formatter}" Foreground="DodgerBlue" FontSize="14">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="True" Step="{Binding SpChartSpectrumStep}" StrokeThickness="1"  Stroke="Pink"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                            <!--控制-->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Grid.ColumnSpan="2">
                                <Button x:Name="buttonReadSpectrum" Style="{StaticResource ButtonSuccess}" IsEnabled="{Binding PINDOWN}" Padding="4" Content="读取光谱" Width="80" Margin="5,0" Click="buttonReadSpectrum_Click"/>
                                <Separator  Margin="0,4,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="15*"/>
                                        <ColumnDefinition Width="50*"/>
                                        <ColumnDefinition Width="55*"/>
                                        <ColumnDefinition Width="55*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="采样: " VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"  HorizontalAlignment="Center">
                                        <TextBlock Text=" 起始" VerticalAlignment="Center"/>
                                        <TextBox Width="50" Margin="2,0,2,0" Text="{Binding StartWavelength}"/>
                                        <TextBlock Text="(nm)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"  HorizontalAlignment="Center">
                                        <TextBlock Text="    结束" VerticalAlignment="Center"/>
                                        <TextBox Width="50" Margin="2,0,2,0" Text="{Binding StopWavelength}"/>
                                        <TextBlock Text="(nm)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text=" 基准" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"/>
                                        <ComboBox x:Name="cbSpWavelengthBaseList" Style="{StaticResource ComboBoxBaseStyle}" ItemsSource="{Binding SpWavelengthBaseList}" SelectedItem="{Binding SpWavelengthBase}" BorderThickness="1" Width="60" HorizontalAlignment="Center" Margin="5,0,5,0" Padding="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" SelectionChanged="cbSpWavelengthBaseList_SelectionChanged"/>
                                        <TextBlock Text="(nm)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Separator  Margin="0,4,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="15*"/>
                                        <ColumnDefinition Width="50*"/>
                                        <ColumnDefinition Width="55*"/>
                                        <ColumnDefinition Width="55*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="结果: " VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"  HorizontalAlignment="Center">
                                        <TextBlock Text="Peak" VerticalAlignment="Center"/>
                                        <TextBox Width="50" Margin="2,0,2,0" Text="{Binding PeakWavelength}" IsReadOnly="True"/>
                                        <TextBlock Text="(nm)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"  HorizontalAlignment="Center">
                                        <TextBlock Text="FWHM" VerticalAlignment="Center"/>
                                        <TextBox Width="50" Margin="2,0,2,0" Text="{Binding FWHM}" IsReadOnly="True"/>
                                        <TextBlock Text="(nm)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal"  HorizontalAlignment="Center">
                                        <TextBlock Text="SNR" VerticalAlignment="Center"/>
                                        <TextBox Width="60" Margin="2,0,2,0" Text="{Binding SNR}" IsReadOnly="True"/>
                                        <TextBlock Text="(dB)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <!--光斑扫描-->
                    <TabItem Background="{StaticResource BackgroundBrush}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Margin="5,0,5,0">
                                <Image Source="/Resources/Beam.png" Width="20" Height="20" VerticalAlignment="Center" Stretch="Fill"/>
                                <TextBlock Text="光斑扫描" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <!--定义了2行-->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>
                            <!--图像-->
                            <Image Source="{Binding BeamImage}" Margin="10,10,10,10"/>
                            <!--按钮-->
                            <Button x:Name="btnBeamCapture" Grid.Row="1" Style="{StaticResource ButtonSuccess}" IsEnabled="{Binding PINDOWN}" Padding="4" Content="读取光斑" Width="80" Margin="5,0" Click="btnBeamCapture_Click"/>
                        </Grid>
                    </TabItem>
                    <!--热像扫描-->
                    <TabItem Background="{StaticResource BackgroundBrush}" Visibility="{Binding ThermCamVisibility}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Margin="5,0,5,0">
                                <Image Source="/Resources/ThermalCamera.png" Width="20" Height="20" VerticalAlignment="Center" Stretch="Fill"/>
                                <TextBlock Text="热像扫描" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <!--定义了2行-->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>
                            <!--图像-->
                            <Image Source="{Binding ThermalImage}" Margin="10,10,10,10"/>
                            <!--按钮-->
                            <Button x:Name="btnTheramlCapture" Grid.Row="1" Style="{StaticResource ButtonSuccess}" Padding="4" Content="读取热像" Width="80" Margin="5,0" Click="btnThermalCapture_Click"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>
