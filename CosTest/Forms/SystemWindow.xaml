<Window x:Class="CosTest.SystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CosTest"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="系统设置" Height="500" Width="900" WindowStyle="None" WindowStartupLocation="CenterScreen" AllowsTransparency="True" Icon="/Resources/Vsstec.ico">
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="dgCell" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Border BorderBrush="Black" BorderThickness="2" Margin="0"/>
        <Grid Margin="1">
            <!--定义了2行-->
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="100*"/>
            </Grid.RowDefinitions>
            <!--标题栏-->
            <Grid x:Name="gridCaption" Grid.Row="0" MouseLeftButtonDown="gridCaption_MouseLeftButtonDown" Background="#FF1565C0">
                <Image Source="/Resources/System.png" HorizontalAlignment="Left" Height="40" Width="40" Margin="10,0,0,0" VerticalAlignment="Center" Stretch="Fill" />
                <TextBlock Text="系统配置" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="80,0,0,0" FontSize="21.333" Foreground="White"/>
                <Button x:Name="buttonClose" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource CloseGeometry}" Padding="4" ToolTip="关闭" Width="24" Height="24" Margin="0,0,10,0" Click="buttonClose_Click" HorizontalAlignment="Right"/>
            </Grid>
            <!--Content-->
            <TabControl Grid.Row="1" >
                <!--第一页 配置文件路径-->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="5,0,5,0">
                            <Image Source="/Resources/Equip.png" Width="20" Height="20" VerticalAlignment="Center" Stretch="Fill"/>
                            <TextBlock Text="机台信息" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid x:Name="gridRack">
                        <!--定义6行-->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="50*"/>
                        </Grid.RowDefinitions>
                        <!--定义5列-->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*"/>
                            <ColumnDefinition Width="100*"/>
                            <ColumnDefinition Width="100*"/>
                            <ColumnDefinition Width="100*"/>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="配置机台信息" HorizontalAlignment="Center" Margin="0" VerticalAlignment="Center" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="30,0,0,0">
                            <TextBlock  Text="机台名称:" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RackName}" VerticalAlignment="Center" Margin="20,0,10,0" Width="200"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,0,40,0">
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="机台编号:" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding RackId}" VerticalAlignment="Center" Margin="20,0,10,0" Width="200"/>
                        </StackPanel>
                        <Button x:Name="buttonSaveRackInfo"  Grid.Row="5" Grid.Column="2"  Content="保存" Margin="10" Style="{StaticResource ButtonSuccess}" Padding="4" Width="80" HorizontalAlignment="Center" Click="buttonSaveRackInfo_Click"/>
                    </Grid>
                </TabItem>
                <!--第二页 配置文件路径-->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="5,0,5,0">
                            <Image Source="/Resources/Folder.png" Width="20" Height="20" VerticalAlignment="Center" Stretch="Fill"/>
                            <TextBlock Text="文件路径" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid x:Name="gridRoot">
                        <!--定义6行-->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="50*"/>
                        </Grid.RowDefinitions>
                        <!--定义3列-->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*"/>
                            <ColumnDefinition Width="250*"/>
                            <ColumnDefinition Width="50*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="配置文件路径" HorizontalAlignment="Center" Margin="0" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="设备信息配置文件:" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="测试程序配置文件:" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="校准数据配置文件:" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="账号信息配置文件:" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="测试规则数据库:" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="测试数据输出路径:" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RackFilePath}" VerticalAlignment="Center" Margin="10,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RoutineFilePath}" VerticalAlignment="Center" Margin="10,0"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CalibrationFilePath}" VerticalAlignment="Center" Margin="10,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding UserFilePath}" VerticalAlignment="Center" Margin="10,0"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding TestMappingFilePath}" IsEnabled="False" VerticalAlignment="Center" Margin="10,0"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding OutputFolderPath}" VerticalAlignment="Center" Margin="10,0"/>
                        <Button x:Name="buttonOpenRackFile" Grid.Row="1" Grid.Column="2" ToolTip="选择设备信息配置文件" hc:IconElement.Geometry="{StaticResource SearchGeometry}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,10,9,10" Height="Auto" Click="buttonOpenRackFile_Click" />
                        <Button x:Name="buttonOpenScriptFile" Grid.Row="2" Grid.Column="2"  ToolTip="选择测试脚本配置文件" hc:IconElement.Geometry="{StaticResource SearchGeometry}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,10,9,10" Height="Auto" Click="buttonOpenScriptFile_Click" />
                        <Button x:Name="buttonOpenCalibrationFile" Grid.Row="3" Grid.Column="2"  ToolTip="选择校准数据配置文件" hc:IconElement.Geometry="{StaticResource SearchGeometry}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,10,9,10" Height="Auto" Click="buttonOpenCalibrationFile_Click" />
                        <Button x:Name="buttonOpenUserFile" Grid.Row="4" Grid.Column="2"  ToolTip="选择账号信息配置文件" hc:IconElement.Geometry="{StaticResource SearchGeometry}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,10,9,10" Height="Auto" Click="buttonOpenUserFile_Click" />
                        <Button x:Name="buttonOpenTestMappingFile" Grid.Row="5" Grid.Column="2" ToolTip="选择测试规则数据库文件" IsEnabled="False"  hc:IconElement.Geometry="{StaticResource SearchGeometry}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,10,9,10" Height="Auto" Click="buttonOpenTestMappingFile_Click" />
                        <Button x:Name="buttonOpenOutputFolder" Grid.Row="6" Grid.Column="2" ToolTip="选择测试数据输出文件夹" hc:IconElement.Geometry="{StaticResource AskGeometry}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,10,9,10" Height="Auto" Click="buttonOpenOutputFolder_Click" />
                        <Grid Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" >
                            <!--定义3列-->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="50*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="buttonDefault"  Grid.Column="1"   Content="默认" Margin="10" Style="{StaticResource ButtonSuccess}" Padding="4" Width="80" HorizontalAlignment="Center" Click="buttonDefault_Click"/>
                            <Button x:Name="buttonSaveRoot"  Grid.Column="3"   Content="保存" Margin="10" HorizontalAlignment="Center" Style="{StaticResource ButtonSuccess}" Padding="4" Width="80" Click="buttonSaveRoot_Click"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <!--第三页 夹具设置-->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="5,0,5,0">
                            <Image Source="/Resources/Puzzle.png" Width="20" Height="20" VerticalAlignment="Center" Stretch="Fill"/>
                            <TextBlock Text="夹具设置" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <!--定义6行-->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40*"/>
                            <RowDefinition Height="200*"/>
                            <RowDefinition Height="10*"/>
                            <RowDefinition Height="50*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="夹具的速度、位置、温度" HorizontalAlignment="Center" Margin="0" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Grid Grid.Row="1" >
                            <!--定义5行-->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50*"/>
                                <RowDefinition Height="50*"/>
                                <RowDefinition Height="50*"/>
                                <RowDefinition Height="50*"/>
                                <RowDefinition Height="50*"/>
                                <RowDefinition Height="50*"/>
                                <RowDefinition Height="50*"/>
                            </Grid.RowDefinitions>
                            <!--定义3列-->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="50*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="马达运动速度(Y):" HorizontalAlignment="Left" VerticalAlignment="Center" Width="115"/>
                                <TextBox Text="{Binding YSPEED}" Width="60" VerticalAlignment="Center" Margin="5,0,5,0" TextAlignment="Center"/>
                                <TextBlock Text="(mm/s)" HorizontalAlignment="Left" VerticalAlignment="Center" Width="60"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="插芯与光阑原点距离:" VerticalAlignment="Center" Width="115"/>
                                <TextBox Text="{Binding NA_ORG_CT_EQ_DIST}" VerticalAlignment="Center" Width="60" Margin="5,0,5,0" TextAlignment="Center"/>
                                <TextBlock Text="(mm)" HorizontalAlignment="Left" VerticalAlignment="Center" Width="60"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="等效光阑直径:" VerticalAlignment="Center" Width="115"/>
                                <TextBox Text="{Binding NA_EQ_DIAMETER}" VerticalAlignment="Center" Width="60" Margin="5,0,5,0" TextAlignment="Center"/>
                                <TextBlock Text="(mm)" HorizontalAlignment="Left" VerticalAlignment="Center" Width="60"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="N.A.加电稳定时间:" VerticalAlignment="Center" Width="115"/>
                                <TextBox Text="{Binding NA_STABLE_TIME_S}" VerticalAlignment="Center" Width="60" Margin="5,0,5,0" TextAlignment="Center"/>
                                <TextBlock Text="(S)" VerticalAlignment="Center" Width="60"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="N.A.扫描行程时间:" VerticalAlignment="Center" Width="115"/>
                                <TextBox Text="{Binding NA_SCAN_TIME_S}" VerticalAlignment="Center" Width="60" Margin="5,0,5,0" TextAlignment="Center"/>
                                <TextBlock Text="(S)" VerticalAlignment="Center" Width="60"/>
                            </StackPanel>
                            <StackPanel Grid.Row="5" Grid.Column="0"  Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="N.A.起始扫描位置(Z):" HorizontalAlignment="Left" VerticalAlignment="Center" Width="115"/>
                                <TextBox Text="{Binding YPANABG}" Width="60" VerticalAlignment="Center" Margin="5,0,5,0" TextAlignment="Center"/>
                                <TextBlock Text="(mm)" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Button x:Name="btnSetYPANABG" ToolTip="读取当前位置作为首个COS位置" IsEnabled="{Binding IS_GALIL_ENABLED}" HorizontalAlignment="Center" Style="{StaticResource ButtonIconCircular}" hc:IconElement.Geometry="{StaticResource DropperGeometry}" Padding="4" Background="{StaticResource WarningBrush}" Width="24" Height="24" Margin="5,0,0,0" Click="btnSetYPANABG_Click"/>
                            </StackPanel>
                            <StackPanel  Grid.Row="6" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="N.A.结束扫描位置(Z):" HorizontalAlignment="Left" VerticalAlignment="Center" Width="115"/>
                                <TextBox Text="{Binding YPANAEND}" Width="60" VerticalAlignment="Center" Margin="5,0,5,0" TextAlignment="Center"/>
                                <TextBlock Text="(mm)" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Button x:Name="btnSetYPANAEND" ToolTip="读取当前位置作为首个COS位置" IsEnabled="{Binding IS_GALIL_ENABLED}" HorizontalAlignment="Center" Style="{StaticResource ButtonIconCircular}" hc:IconElement.Geometry="{StaticResource DropperGeometry}" Padding="4" Background="{StaticResource WarningBrush}" Width="24" Height="24" Margin="5,0,0,0" Click="btnSetYPANAEND_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="温度上限:" VerticalAlignment="Center" Width="80"/>
                                <TextBox Text="{Binding TEMP_UCL}" VerticalAlignment="Center" Width="60"  Margin="5,0,5,0" TextAlignment="Center"/>
                                <TextBlock Text="(℃)" VerticalAlignment="Center" Width="25"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="温度下限:" VerticalAlignment="Center" Width="80"/>
                                <TextBox Text="{Binding TEMP_LCL}" VerticalAlignment="Center" Width="60" Margin="5,0,5,0" TextAlignment="Center"/>
                                <TextBlock Text="(℃)" VerticalAlignment="Center" Width="25"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="最大温控误差:" VerticalAlignment="Center" Width="80"/>
                                <TextBox Text="{Binding TEMP_ERR_UCL}" VerticalAlignment="Center" Width="60" Margin="5,0,5,0" TextAlignment="Center"/>
                                <TextBlock Text="(℃)" VerticalAlignment="Center" Width="25"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="TEC电流上限:" VerticalAlignment="Center" Width="80"/>
                                <TextBox Text="{Binding TEC_CURR_UCL}" VerticalAlignment="Center" Width="60" Margin="5,0,5,0" TextAlignment="Center"/>
                                <TextBlock Text="(A)" VerticalAlignment="Center" Width="25"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="TEC电压上限:" VerticalAlignment="Center" Width="80"/>
                                <TextBox Text="{Binding TEC_VOLT_UCL}" VerticalAlignment="Center" Width="60" Margin="5,0,5,0" TextAlignment="Center"/>
                                <TextBlock Text="(V)" VerticalAlignment="Center" Width="25"/>
                            </StackPanel>
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="温控稳定时间:" VerticalAlignment="Center" Width="80"/>
                                <TextBox Text="{Binding TEMP_STABLE_TIME_S}" VerticalAlignment="Center" Width="60" Margin="5,0,5,0" TextAlignment="Center"/>
                                <TextBlock Text="(S)" VerticalAlignment="Center" Width="25"/>
                            </StackPanel>
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="温控超时时间:" VerticalAlignment="Center" Width="80"/>
                                <TextBox Text="{Binding TEMP_TIME_OUT_S}" VerticalAlignment="Center" Width="60" Margin="5,0,5,0" TextAlignment="Center"/>
                                <TextBlock Text="(S)" VerticalAlignment="Center" Width="25"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="电源电流上限:" VerticalAlignment="Center" Width="100"/>
                                <TextBox Text="{Binding LASER_CURR_UCL}" VerticalAlignment="Center" Width="60" Margin="5,0,5,0" TextAlignment="Center"/>
                                <TextBlock Text="(A)" VerticalAlignment="Center" Width="25"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="电源电压上限:" VerticalAlignment="Center" Width="100"/>
                                <TextBox Text="{Binding LASER_VOLT_UCL}" VerticalAlignment="Center" Width="60" Margin="5,0,5,0" TextAlignment="Center"/>
                                <TextBlock Text="(V)" VerticalAlignment="Center" Width="25"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center" Width="100" Text="光谱加电稳定时间:"/>
                                <TextBox Text="{Binding SP_STABLE_TIME_S}" VerticalAlignment="Center" Width="60" Margin="5,0,5,0" TextAlignment="Center"/>
                                <TextBlock Text="(S)" VerticalAlignment="Center" Width="25"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center" Width="100" Text="PD通道:"/>
                                <ComboBox SelectedItem="{Binding PD_RNG}" ItemsSource="{Binding PD_RNG_LIST}" IsEnabled="True" VerticalAlignment="Center" Width="60" Margin="5,0,5,0"/>
                                <TextBlock Text="" VerticalAlignment="Center" Width="25"/>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="buttonSaveJigParam"  Grid.Row="5" Grid.Column="2"  Content="保存" Style="{StaticResource ButtonSuccess}" Padding="4" Width="80" Margin="10" HorizontalAlignment="Center" Click="buttonSaveJigParam_Click"/>
                    </Grid>
                </TabItem>
                <!--第四页 校准参数-->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="5,0,5,0">
                            <Image Source="/Resources/Calibrate.png" Width="20" Height="20" VerticalAlignment="Center" Stretch="Fill"/>
                            <TextBlock Text="校准参数" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <!--定义6行-->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="40*"/>
                            <RowDefinition Height="40*"/>
                            <RowDefinition Height="40*"/>
                            <RowDefinition Height="150*"/>
                            <RowDefinition Height="40*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="校准系数" HorizontalAlignment="Center" Margin="0" VerticalAlignment="Center" FontWeight="Bold"/>
                        <UniformGrid Grid.Row="1" Rows="1" Margin="10,0,10,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="SI_CAL:      " HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding SI_CAL}" Width="40" VerticalAlignment="Center" Margin="5,0,5,0" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="I_CAL:      " HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding I_CAL}" Width="40" VerticalAlignment="Center" Margin="5,0,5,0" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="V_CAL:      " HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding V_CAL}" Width="40" VerticalAlignment="Center" Margin="5,0,5,0" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="ST_CAL:      " HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding ST_CAL}" Width="40" VerticalAlignment="Center" Margin="5,0,5,0" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="RT_CAL:      " HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding RT_CAL}" Width="40" VerticalAlignment="Center" Margin="5,0,5,0" TextAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>
                        <UniformGrid Grid.Row="2" Rows="1" Margin="10,0,10,0" >
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="SI_OFFSET:" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding SI_OFFSET}" Width="40" VerticalAlignment="Center" Margin="5,0,5,0" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="I_OFFSET:" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding I_OFFSET}" Width="40" VerticalAlignment="Center" Margin="5,0,5,0" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="V_OFFSET:" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding V_OFFSET}" Width="40" VerticalAlignment="Center" Margin="5,0,5,0" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="ST_OFFSET:" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding ST_OFFSET}" Width="40" VerticalAlignment="Center" Margin="5,0,5,0" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="RT_OFFSET:" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding RT_OFFSET}" Width="40" VerticalAlignment="Center" Margin="5,0,5,0" TextAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>
                        <UniformGrid Grid.Row="3" Rows="1" Margin="10,0,10,0" >
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="SP_NOISE:" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding SP_NOISE}" Width="40" VerticalAlignment="Center" Margin="5,0,5,0" TextAlignment="Center" ToolTip="单位是方差"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="SP DeNoise:" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <CheckBox IsChecked="{Binding SP_DENOISE_ENABLE}" VerticalAlignment="Center"  Margin="10,0,5,0"/>
                            </StackPanel>
                            <StackPanel/>
                            <StackPanel/>
                            <StackPanel/>
                        </UniformGrid>
                        <!--光谱校准-->
                        <DataGrid Grid.Row="4" Background="Transparent" AutoGenerateColumns="False" ItemsSource="{Binding PoCalData}" CanUserSortColumns="False" Style="{StaticResource BaseStyle}" CanUserAddRows="False" CanUserDeleteRows="False" HorizontalContentAlignment="Center"
                                          BorderBrush="DodgerBlue" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="Gray" RowBackground="LightYellow" AlternatingRowBackground="LightCyan" RowHeight="25" HeadersVisibility="Column" ColumnHeaderHeight="25" Padding="1" Margin="40,0,40,0">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="DodgerBlue"/>
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="序号" Width="30*" IsReadOnly="True" Binding="{Binding ID}" ElementStyle="{StaticResource dgCell}"/>
                                <DataGridTextColumn Header="基准波长" Width="50*" IsReadOnly="True" Binding="{Binding WAVELENGTH_BASE}" ElementStyle="{StaticResource dgCell}"/>
                                <DataGridTextColumn Header="功率CAL" Width="50*" Binding="{Binding PO_CAL}" ElementStyle="{StaticResource dgCell}"/>
                                <DataGridTextColumn Header="功率OFFSET" Width="50*" Binding="{Binding PO_OFFSET}" ElementStyle="{StaticResource dgCell}"/>
                                <DataGridTextColumn Header="波长OFFSET" Width="50*" Binding="{Binding WAVELENGTH_OFFSET}" ElementStyle="{StaticResource dgCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button x:Name="buttonSaveCalibrationParam"  Grid.Row="5" Grid.Column="2"  Content="保存" Style="{StaticResource ButtonSuccess}" Padding="4" Width="80" Margin="10" HorizontalAlignment="Center" Click="buttonSaveCalibrationParam_Click"/>
                    </Grid>
                </TabItem>
                <!--第五页 通讯地址-->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="5,0,5,0">
                            <Image Source="/Resources/Usb.png" Width="20" Height="20" VerticalAlignment="Center" Stretch="Fill"/>
                            <TextBlock Text="设备地址" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <!--定义6行-->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="50*"/>
                        </Grid.RowDefinitions>
                        <!--定义5列-->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*"/>
                            <ColumnDefinition Width="100*"/>
                            <ColumnDefinition Width="100*"/>
                            <ColumnDefinition Width="100*"/>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="设备通讯地址" HorizontalAlignment="Center" Margin="0" VerticalAlignment="Center" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="30,0,0,0">
                            <TextBlock  Text="功率计串口地址:" Width="125" HorizontalAlignment="Left"  Margin="20,0,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" SelectedItem="{Binding PD_COMM_PORT}" ItemsSource="{Binding CommAddrList}" VerticalAlignment="Center" Margin="20,0,10,0" Width="150"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,0,40,0">
                            <TextBlock Grid.Row="1" Text="温控器串口地址:" HorizontalAlignment="Left" Width="125" Margin="20,0,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" SelectedItem="{Binding TEMP_COMM_PORT}" ItemsSource="{Binding CommAddrList}" VerticalAlignment="Center" Margin="20,0,10,0" Width="150"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="30,0,0,0">
                            <TextBlock  Text="运动控制器串口地址:" Width="125" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" SelectedItem="{Binding MOTOR_COMM_PORT}" ItemsSource="{Binding CommAddrList}" VerticalAlignment="Center" Margin="20,0,10,0" Width="150"/>
                        </StackPanel>
                        <!--<StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,0,40,0">
                            <TextBlock Grid.Row="1" Text="光斑相机通道:" HorizontalAlignment="Left" Width="125" Margin="20,0,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" SelectedItem="{Binding BEAM_USB_CAM_ID}" ItemsSource="{Binding UsbCamList}" VerticalAlignment="Center" Margin="20,0,10,0" Width="150"/>
                        </StackPanel>-->
                        <Button x:Name="buttonSaveCommAddr"  Grid.Row="5" Grid.Column="2"  Content="保存" Margin="10" Style="{StaticResource ButtonSuccess}" Padding="4" Width="80" HorizontalAlignment="Center" Click="buttonSaveCommAddr_Click"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
