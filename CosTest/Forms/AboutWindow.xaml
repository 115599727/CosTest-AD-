<Window x:Class="CosTest.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CosTest"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="关于" Height="500" Width="800" Icon="/Resources/Vsstec.ico" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True">
    <Grid>
        <Border BorderBrush="Black" BorderThickness="2" Margin="0"/>
        <Grid Margin="1">
            <!--定义了2行-->
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="100*"/>
            </Grid.RowDefinitions>
            <!--标题栏-->
            <Grid x:Name="gridCaption" Grid.Row="0" MouseLeftButtonDown="gridCaption_MouseLeftButtonDown" Background="#FF1565C0">
                <Image Source="/Resources/About.png" HorizontalAlignment="Left" Height="40" Width="40" Margin="10,0,0,0" VerticalAlignment="Center" Stretch="Fill" />
                <TextBlock Text="关于" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="80,0,0,0" FontSize="21.333" Foreground="White"/>
                <Button x:Name="buttonClose" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource CloseGeometry}" Padding="4" ToolTip="关闭" Width="24" Height="24" Margin="0,0,10,0" Click="buttonClose_Click" HorizontalAlignment="Right"/>
            </Grid>
            <!--Content-->
            <Grid Grid.Row="1">
                <Grid.Background>
                    <ImageBrush ImageSource="/Resources/BgAbout.jpg"/>
                </Grid.Background>
                <StackPanel x:Name="spAbout"   Margin="10">
                    <TextBlock Text="{Binding EquipName}" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding EquipPartNo}" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding SoftwareVersion}" Margin="0,5,0,0"/>
                    <TextBlock Text="生产厂商： 韦斯泰科技(深圳)有限公司" Margin="0,5,0,0"/>
                    <Image Source="Resources/Company.png" Stretch="Fill" Width="120" HorizontalAlignment="Left" Height="50" Margin="0,32,0,0" />
                    <TextBlock Text="关于韦斯泰科技" Margin="0,5,0,0" FontWeight="Bold" />
                    <TextBlock TextWrapping="Wrap" Text="       韦斯泰科技（深圳）有限公司位于深圳市宝安区，是一家专业研发、生产和经营真空共晶炉、平行封焊、真空烘烤箱以及芯片发散角测试装置的技术企业。为光通讯、智能传感、高功率器件和国防军工提供封装解决方案。" LineHeight="20" Margin="0,5,0,0"/>
                    <TextBlock TextWrapping="Wrap" Text="        公司奉行 质量高于一切，创新成就未来 的经营理念，追求一流的品质和技术，真诚地为用户提供领先可靠的产品及服务。" Margin="0,5,0,0" />
                    <TextBlock Text="公司网站： www.vsstec.com" Margin="0,5,0,0"/>
                    <TextBlock Text="电子邮箱： Vsstec@vsstec.com" Margin="0,5,0,0"/>
                    <TextBlock Text="联系电话： 徐生13798291680/0755-26606859" Margin="0,5,0,0"/>
                    <TextBlock Text="                  范生18123656966/0755-26601225" Margin="0,5,0,0"/>
                    <TextBlock Text="联系地址： 深圳市宝安区石岩街道水田社区捷家宝路9号羿松生态园A栋3楼" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>