<Window x:Class="CosTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:CosTest"
        mc:Ignorable="d"
        Title="激光器测试系统" Height="768" Width="1024" WindowStyle="None" Icon="/Resources/Vsstec.ico" AllowsTransparency="True" WindowStartupLocation="CenterScreen">
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="ResizeMode" Value="CanResize" />
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome CaptionHeight="0" ResizeBorderThickness="4" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Style>
    <Border Margin="0"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="0"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10"
                              Direction="0"
                              ShadowDepth="0" />
        </Border.Effect>
        <Grid>
            <Grid Margin="0">
                <!--定义了2行-->
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="100*"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="5"/>
                </Grid.RowDefinitions>
                <!--标题栏-->
                <Grid x:Name="gridCaption" Grid.Row="0" MouseLeftButtonDown="gridCaption_MouseLeftButtonDown">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="white"></GradientStop>
                            <GradientStop Offset="0.7" Color="#FF1565C0"></GradientStop>
                            <GradientStop Offset="1.0" Color="#FF1565C0"></GradientStop>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <!--LOGO & EQUIP-->
                    <Image x:Name="image" Source="/Resources/Company.png" HorizontalAlignment="Left" Height="50" Margin="0,0,0,0" VerticalAlignment="Top" Width="150"/>
                    <TextBlock Text="激光器测试系统" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="150,0,0,0" FontSize="21.333" />
                    <!--MAIN CAPTION BUTTONS-->
                    <StackPanel x:Name="spSetting" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="100,0,0,0">
                        <Button x:Name="buttonScript" Style="{StaticResource ButtonDefault}" Padding="2" IsEnabled="{Binding SysEditEnabled}" ToolTip="测试程序" Height="32" Margin="9,0,5,0" Click="buttonScript_Click">
                            <Image Source="/Resources/Test.png"/>
                        </Button>
                        <Button x:Name="buttonThermConfig" Style="{StaticResource ButtonDefault}" Padding="2" IsEnabled="{Binding SysEditEnabled}" Visibility="{Binding ThermConfigVisibility}" ToolTip="定义温度测量区域" Height="32" Margin="9,0,5,0" Click="buttonThermConfig_Click">
                            <Image Source="/Resources/ThermalCamera.PNG"/>
                        </Button>
                        <Button x:Name="buttonSystem" Style="{StaticResource ButtonDefault}" Padding="2" IsEnabled="{Binding SysEditEnabled}" ToolTip="系统设置" Height="32" Margin="5,0" Click="buttonSystem_Click">
                            <Image Source="/Resources/System.png"/>
                        </Button>
                        <Button x:Name="buttonTool" Style="{StaticResource ButtonDefault}" Padding="2" IsEnabled="{Binding SysEditEnabled}" ToolTip="调试工具" Height="32" Margin="10,0,5,0" Click="buttonTool_Click">
                            <Image Source="/Resources/Tool.png"/>
                        </Button>
                        <Button x:Name="buttonUser" Style="{StaticResource ButtonDefault}" Padding="2" IsEnabled="{Binding SysEditEnabled}" ToolTip="用户管理" Height="32" Margin="10,0,5,0" Click="buttonUser_Click">
                            <Image Source="/Resources/User.png"/>
                        </Button>
                        <Button x:Name="buttonAbout" Style="{StaticResource ButtonDefault}" Padding="3,0,2,2" ToolTip="关于" Height="32" Margin="10,0,5,0" Click="buttonAbout_Click">
                            <Image Source="/Resources/About.png"/>
                        </Button>
                    </StackPanel>
                    <!--LOGON-->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,150,0">
                        <Button x:Name="buttonLogin" Style="{StaticResource ButtonCustom}"   ToolTip="{Binding LOGIN_TIPS}" Height="24" Margin="5,0" Click="buttonLogin_Click">
                            <Image Source="{Binding LOGIN_ICON}"/>
                        </Button>
                    </StackPanel>
                    <!--WINDOW STATE-->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="buttonMinimize" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource WindowMinGeometry}" Padding="4" ToolTip="最小化" Width="24" Height="24" Margin="5,0" Click="buttonMinimize_Click" />
                        <Button x:Name="buttonMaximize" Padding="4" ToolTip="{Binding MAX_NORMAL_TIPS}" Width="24" Height="24" Margin="5,0" Click="buttonMaximize_Click" >
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonIcon}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MAX_NORMAL_ICON}" Value="True" >
                                            <Setter Property="hc:IconElement.Geometry" Value="{StaticResource WindowMaxGeometry}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MAX_NORMAL_ICON}" Value="False" >
                                            <Setter Property="hc:IconElement.Geometry" Value="{StaticResource WindowRestoreGeometry}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="buttonClose" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource CloseGeometry}" Padding="4" ToolTip="关闭" Width="24" Height="24" Margin="5,0" Click="buttonClose_Click"/>
                    </StackPanel>
                </Grid>
                <!--测试功能区-->
                <Grid Grid.Row="1">
                    <!--定义了2行-->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25*"/>
                        <RowDefinition Height="150*"/>
                    </Grid.RowDefinitions>
                    <!--控制参数区域-->
                    <Grid x:Name="gridTrayControl" Grid.Row="0" Margin="0,10,0,0">
                        <!--定义了2行-->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25*"/>
                            <RowDefinition Height="30*"/>
                        </Grid.RowDefinitions>
                        <!--第0行-->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100*"/>
                                <ColumnDefinition Width="100*"/>
                                <ColumnDefinition Width="100*"/>
                                <ColumnDefinition Width="100*"/>
                                <ColumnDefinition Width="200*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="批次号 " HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBox x:Name="tbBatchNo" Text="{Binding BatchNo}" IsEnabled="{Binding BatchLoadEnabled}" Background="Azure" VerticalAlignment="Center" Width="100" TextAlignment="Center" Margin="5,0,5,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="序列号 " HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBox x:Name="tbSerialNo" Text="{Binding SerialNo}" IsEnabled="{Binding BatchLoadEnabled}" Background="Azure" VerticalAlignment="Center" Width="100" TextAlignment="Center" Margin="5,0,5,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="型号 " HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBox x:Name="tbPartNo" Text="{Binding PartNo}" IsEnabled="{Binding BatchLoadEnabled}" Background="Azure" VerticalAlignment="Center" Width="100" TextAlignment="Center" Margin="5,0,5,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="工序 " HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <ComboBox x:Name="cbStageList" Padding="0" Width="100"  ItemsSource="{Binding StageList}" SelectedItem="{Binding TestStage}" IsEnabled="{Binding BatchLoadEnabled}" Background="Azure" HorizontalContentAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="测试程序 " HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <ComboBox x:Name="cbRoutineNameList" Padding="0" Width="200"  ItemsSource="{Binding ScriptNameList}" SelectedItem="{Binding SelScriptName}" IsEnabled="{Binding BatchLoadEnabled}" Background="Azure" HorizontalContentAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>


                        <!--第4行-->
                        <UniformGrid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="8" Rows="1">
                            <Button x:Name="buttonStart" IsEnabled="{Binding BtnStartEnabled}" ToolTip="开始测试"  Style="{StaticResource ButtonDefault}" VerticalAlignment="Center" BorderBrush="Blue" Click="buttonStart_Click" >
                                <WrapPanel>
                                    <Image Source="/Resources/Start.png" HorizontalAlignment="Left" Height="18" Width="18" Margin="0,0,0,0" VerticalAlignment="Center" Stretch="Fill" />
                                    <TextBlock Text="开始" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </WrapPanel>
                            </Button>
                            <Button x:Name="buttonStop" IsEnabled="{Binding BtnStopEnabled}" ToolTip="结束测试" Style="{StaticResource ButtonDefault}" VerticalAlignment="Center" BorderBrush="Blue" Click="buttonStop_Click" >
                                <WrapPanel>
                                    <Image Source="/Resources/Stop.png" HorizontalAlignment="Left" Height="18" Width="18" Margin="0,0,0,0" VerticalAlignment="Center" Stretch="Fill"/>
                                    <TextBlock Text="停止" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </WrapPanel>
                            </Button>
                            <Button x:Name="buttonPause" IsEnabled="{Binding BtnPauseEnabled}" ToolTip="暂停测试" Style="{StaticResource ButtonDefault}" VerticalAlignment="Center" BorderBrush="Blue" Click="buttonPause_Click">
                                <WrapPanel>
                                    <Image Source="/Resources/Pause.png" HorizontalAlignment="Left" Height="18" Width="18" Margin="0,0,0,0" VerticalAlignment="Center" Stretch="Fill"/>
                                    <TextBlock Text="暂停" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </WrapPanel>
                            </Button>
                            <Button x:Name="buttonResume" IsEnabled="{Binding BtnResumeEnabled}" ToolTip="继续测试" Style="{StaticResource ButtonDefault}" VerticalAlignment="Center" BorderBrush="Blue" Click="buttonResume_Click">
                                <WrapPanel>
                                    <Image Source="/Resources/Resume.png" HorizontalAlignment="Left" Height="18" Width="18" Margin="0,0,0,0" VerticalAlignment="Center" Stretch="Fill"/>
                                    <TextBlock Text="继续" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </WrapPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="buttonClear" IsEnabled="{Binding BtnClearEnabled}"  ToolTip="清空当前的输入信息和图表" Style="{StaticResource ButtonIconCircular}" hc:IconElement.Geometry="{StaticResource AlignVCenterGeometry}" Foreground="Red" Padding="5" HorizontalAlignment="Left" Width="24" Height="24" Click="buttonClear_Click" Margin="20,0,0,0"/>
                                <Button x:Name="buttonOpenResultFiles" IsEnabled="{Binding BtnOpenResultEnabled}"  ToolTip="打开当前的测试数据文件" Style="{StaticResource ButtonIconCircular}" hc:IconElement.Geometry="{StaticResource EyeOpenGeometry}" Foreground="Blue" Padding="3" HorizontalAlignment="Center" Width="24" Height="24" Click="buttonOpenResultFiles_Click" Margin="20,0,0,0" />
                                <Button x:Name="buttonLoadResultFile" IsEnabled="{Binding BtnLoadResultEnabled}"  ToolTip="可视化查看测试数据文件" Style="{StaticResource ButtonIconCircular}" hc:IconElement.Geometry="{StaticResource AllGeometry}" Foreground="Green" HorizontalAlignment="Right" Width="24" Height="24" Margin="20,0,0,0" Padding="4" Click="buttonLoadResultFile_Click"/>
                            </StackPanel>
                        </UniformGrid>

                    </Grid>
                    <!--数据参数区域-->
                    <Grid Grid.Row="1">
                        <!--定义了2行-->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="75"/>
                            <RowDefinition Height="75"/>
                            <RowDefinition Height="100*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <!--定义了2行-->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="2,0,2,0">
                                <Border BorderBrush="LightBlue" BorderThickness="1" CornerRadius="2" Background="Azure"/>
                                <TextBlock Text="设备状态" FontSize="12" FontWeight="Bold" Foreground="DarkBlue" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                            <UniformGrid Grid.Row="1" Rows="1">

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="安全互锁:" VerticalAlignment="Center"/>
                                    <Image Height="24" Width="28" Margin="10,0,0,0" Source="{Binding LockImage}" ToolTip="{Binding LockStatus}" Stretch="Fill"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="夹具温度:" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding TMP}" VerticalAlignment="Center" Width="75" IsReadOnly="True" TextAlignment="Center" Margin="10,0,10,0" FontWeight="Bold"  Background="Lavender"/>
                                    <TextBlock Text="(℃)" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="马达坐标:" VerticalAlignment="Center" Width="55"/>
                                    <TextBox Text="{Binding POSY}" VerticalAlignment="Center" Width="75" IsReadOnly="True" TextAlignment="Center" Margin="5,0,0,0" FontWeight="Bold"  Background="Lavender"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="马达复位:" VerticalAlignment="Center" Width="55"/>
                                    <CheckBox IsChecked="{Binding HOME}" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="反射镜到位:" VerticalAlignment="Center" Width="70"/>
                                    <CheckBox IsChecked="{Binding MIRROR}" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="Bold" />
                                </StackPanel>
                            </UniformGrid>
                        </Grid>

                        <Grid Grid.Row="1">
                            <!--定义了2行-->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="50*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="2,0,2,0">
                                <Border BorderBrush="LightBlue" BorderThickness="1" CornerRadius="2" Background="Azure"/>
                                <TextBlock Text="测试进度" FontSize="12" FontWeight="Bold" Foreground="DarkBlue" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <!--测试进度-->
                                <UniformGrid Rows="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" >
                                        <TextBlock Text="测试状态:" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding CurrTestStatus}" VerticalAlignment="Center" Width="70" IsReadOnly="True" TextAlignment="Center" Margin="10,0,10,0" FontWeight="Bold"  Background="Lavender"/>
                                        <Ellipse Width="20" Height="20" Fill="{Binding CurrTestSpotFill}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="设定温度:" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding TSET}" VerticalAlignment="Center" Width="75" IsReadOnly="True" TextAlignment="Center" Margin="10,0,10,0" FontWeight="Bold"  Background="Lavender"/>
                                        <TextBlock Text="(℃)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="当前操作:" VerticalAlignment="Center" Width="55"/>
                                        <TextBox Text="{Binding CurrTestSubAction}" VerticalAlignment="Center"  Width="75" IsReadOnly="True" TextAlignment="Center" Margin="5,0,0,0" FontWeight="Bold" Background="Lavender"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="测试结果:" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        <TextBox Text="{Binding CurrTestResult}" VerticalAlignment="Center" Width="75" IsReadOnly="True" TextAlignment="Center" Margin="10,0,10,0" Foreground="{Binding CurrTestResultColor}" FontWeight="Bold"  Background="Lavender"/>
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Grid>

                        <!--数据-->
                        <Grid Grid.Row="2" >
                            <!--定义了2行-->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="50*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="2,0,2,0">
                                <Border BorderBrush="LightBlue" BorderThickness="1" CornerRadius="2" Background="Azure"/>
                                <TextBlock Text="{Binding TestDataHeaderText}" FontSize="12" FontWeight="Bold" Foreground="DarkBlue" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Row="1" >
                                <!--定义3列-->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*"/>
                                    <ColumnDefinition Width="50*"/>
                                    <ColumnDefinition Width="30*"/>
                                </Grid.ColumnDefinitions>
                                <!--LIV图-->
                                <lvc:CartesianChart Visibility="{Binding ChartVisibility}" AxisY="{Binding LivAxesY}" Grid.Column="0" Margin="5" lvc:DisableAnimations="True" Series="{Binding LivSeries}"  DataTooltip="{Binding LivToolTip}" LegendLocation="Top" MouseLeftButtonDown="LivSpImage_MouseLeftButtonDown"  >
                                    <!--X坐标轴-->
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Title="Current(A)" MinValue="0" MaxValue="{Binding LivChartCurrentStop}"  LabelFormatter="{Binding Formatter}"  Foreground="Black" FontSize="14">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator IsEnabled="True" Step="{Binding LivChartCurrentStep}" StrokeThickness="1" Stroke="Pink"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                </lvc:CartesianChart>
                                <!--光谱图-->
                                <lvc:CartesianChart Visibility="{Binding ChartVisibility}" Grid.Column="1" Margin="5" lvc:DisableAnimations="True" Series="{Binding SpectrumSeries}" DataTooltip="{Binding SpToolTip}" LegendLocation="Top" MouseLeftButtonDown="LivSpImage_MouseLeftButtonDown">
                                    <!--X坐标轴-->
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Title="Wavelength(nm)" MinValue="{Binding SpChartWavelengthLCL}" MaxValue="{Binding SpChartWavelengthUCL}" LabelFormatter="{Binding Formatter}" Foreground="Black" FontSize="14">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator IsEnabled="True" Step="{Binding SpChartWavelengthStep}" StrokeThickness="1" Stroke="Pink"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                    <!--Y坐标轴-->
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis  Title="Intensity" MinValue="0" MaxValue="{Binding SpChartSpectrumUCL}" LabelFormatter="{Binding Formatter}" Foreground="DodgerBlue" FontSize="14">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator IsEnabled="True" Step="{Binding SpChartSpectrumStep}" StrokeThickness="1"  Stroke="Pink"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                                <!--光斑图-->
                                <Image Source="{Binding BeamImage}" Visibility="{Binding BeamImageVisibility}" Grid.ColumnSpan="2" Margin="10" MouseLeftButtonDown="BeamImage_MouseLeftButtonDown"/>
                                <!--热成像图-->
                                <Image Source="{Binding ThermalImage}" Visibility="{Binding ThermalImageVisibility}" Grid.ColumnSpan="2" Margin="10" MouseLeftButtonDown="ThermalImage_MouseLeftButtonDown"/>
                                <!--参数列表-->
                                <DataGrid Name="dataGridLivLimit" Grid.Column="2" Background="Transparent" AutoGenerateColumns="False" ItemsSource="{Binding CosTestResultData}" CanUserSortColumns="False" Style="{StaticResource BaseStyle}"
                                          BorderBrush="DodgerBlue" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="Gray" RowBackground="LightYellow" AlternatingRowBackground="LightCyan" RowHeight="25" HeadersVisibility="Column" ColumnHeaderHeight="25" Padding="1" Margin="5,5,5,5">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="{x:Type DataGridColumnHeader}">
                                            <Setter Property="Background" Value="DodgerBlue"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="{x:Type DataGridCell}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <TextBlock TextAlignment="Center" VerticalAlignment="Center">
                                                            <ContentPresenter  />
                                                        </TextBlock>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <!--<DataGridTextColumn Header="序号" Width="50*" IsReadOnly="True" Binding="{Binding Id}"/>-->
                                        <DataGridTextColumn Header="参数" Width="90*" IsReadOnly="True" Binding="{Binding ParamName}"/>
                                        <!--<DataGridTextColumn Header="下限" Width="70*" IsReadOnly="True" Binding="{Binding ParamMin}"/>
                                        <DataGridTextColumn Header="上限" Width="70*" IsReadOnly="True" Binding="{Binding ParamMax}"/>-->
                                        <DataGridTextColumn Header="测试值" Width="50*" IsReadOnly="True" Binding="{Binding TestValue}"/>
                                        <DataGridTextColumn Header="结果" Width="50*" IsReadOnly="True" Binding="{Binding TestResult}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>

                    </Grid>
                </Grid>
                <!--软件信息功能区-->
                <UniformGrid Grid.Row="2" Rows="1">
                    <TextBlock Text="韦斯泰科技（深圳）有限公司" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="高功率激光器测试系统" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding EquipPartNo}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SoftwareVersion}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </UniformGrid>
            </Grid>
        </Grid>
    </Border>
</Window>
