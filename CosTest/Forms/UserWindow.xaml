<Window x:Class="CosTest.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CosTest"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="修改用户信息" Height="280" Width="525" WindowStyle="None" WindowStartupLocation="CenterScreen" AllowsTransparency="True" Icon="/Resources/Vsstec.ico">
    <Grid>
        <Border BorderBrush="Black" BorderThickness="1" Margin="0"/>
        <Grid Margin="1">
            <!--定义了2行-->
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="100*"/>
            </Grid.RowDefinitions>
            <!--标题栏-->
            <Grid x:Name="gridCaption" Grid.Row="0" MouseLeftButtonDown="gridCaption_MouseLeftButtonDown" Background="#FF1565C0">
                <Image Source="/Resources/User.png" HorizontalAlignment="Left" Height="40" Width="40" Margin="10,0,0,0" VerticalAlignment="Center" Stretch="Fill" />
                <TextBlock Text="用户管理" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="80,0,0,0" FontSize="21.333" Foreground="White"/>
                <Button x:Name="buttonClose" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource CloseGeometry}" Padding="4" ToolTip="关闭" Width="24" Height="24" Margin="0,0,10,0" Click="buttonClose_Click" HorizontalAlignment="Right"/>
            </Grid>
            <!--Content-->
            <Grid x:Name="gridUser" Grid.Row="1">
                <!--定义2行-->
                <Grid.RowDefinitions>
                    <RowDefinition Height="50*"/>
                    <RowDefinition Height="50*"/>
                </Grid.RowDefinitions>
                <!--第一行 编辑已有用户信息-->
                <Grid Grid.Row="0" Margin="5,5,5,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="432*"/>
                        <ColumnDefinition Width="67*"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="Black" BorderThickness="2"  CornerRadius="10" Grid.ColumnSpan="2"/>
                    <StackPanel Grid.ColumnSpan="2">
                        <StackPanel Margin="0,0,0,0">
                            <TextBlock Text="编辑:" Margin="10,10,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,10,0,0">
                            <StackPanel>
                                <TextBlock Text="用户名" HorizontalAlignment="Center"/>
                                <ComboBox x:Name="cbUserList" ItemsSource="{Binding UserNameList}" SelectedItem="{Binding SelUserName}" ToolTip="用户名"  Width="100" Margin="10,10,10,0" SelectionChanged="cbUserList_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="密码" HorizontalAlignment="Center"/>
                                <TextBox x:Name="tbSelUserPassord" Text="{Binding SelUserPassword}" ToolTip="密码" VerticalAlignment="Center" Width="100" Margin="10,10,10,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="权限分组" HorizontalAlignment="Center"/>
                                <ComboBox x:Name="cbGroupList" ItemsSource="{Binding GroupList}" SelectedItem="{Binding SelUserGroup}" ToolTip="权限分组"  Width="100" Margin="10,10,10,0"/>
                            </StackPanel>
                            <Button x:Name="buttonSave"  ToolTip="保存用户信息的更改" Margin="10,0" Click="buttonSave_Click" hc:IconElement.Geometry="{StaticResource SaveGeometry}"/>
                            <Button x:Name="buttonDelete"  ToolTip="删除用户" Margin="0" Click="buttonDelete_Click"  hc:IconElement.Geometry="{StaticResource CloseGeometry}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <!--第二行 新建已有用户信息-->
                <Grid Grid.Row="1" Margin="5,0,5,5">
                    <Border BorderBrush="Black" BorderThickness="2"  CornerRadius="10"/>
                    <StackPanel>
                        <StackPanel Margin="0,0,0,0">
                            <TextBlock Text="新增:" Margin="10,10,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,10,0,0">
                            <StackPanel>
                                <TextBlock Text="用户名" HorizontalAlignment="Center"/>
                                <TextBox x:Name="tbNewUserName" Text="{Binding NewUserName}" ToolTip="新用户名"   VerticalAlignment="Center" Width="100" Margin="10,10,10,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="密码" HorizontalAlignment="Center"/>
                                <TextBox x:Name="tbNewUserPassword" Text="{Binding NewUserPassword}" ToolTip="密码"    VerticalAlignment="Center" Width="100" Margin="10,10,10,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="权限分组" HorizontalAlignment="Center"/>
                                <ComboBox x:Name="cbNewGroupList" ItemsSource="{Binding GroupList}" SelectedItem="{Binding NewUserGroup}"  ToolTip="权限分组"  Width="100" Margin="10,10,10,0"/>
                            </StackPanel>
                            <Button x:Name="buttonNew"   ToolTip="创建新用户" Margin="10,0" Click="buttonNew_Click" hc:IconElement.Geometry="{StaticResource  TwoPageModeGeometry}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
