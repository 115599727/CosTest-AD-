<FixedPage 
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" 
    xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
	x:Name="Window" 
	UseLayoutRounding="True"
	Height="891" Width="630">

    <Grid x:Name="ReportGrid" Height="891" Width="630">
        <!--定义了4行-->
        <Grid.RowDefinitions>
            <RowDefinition Height="25*"/>
            <RowDefinition Height="25*"/>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="100*"/>
        </Grid.RowDefinitions>
        <!--标题-->
        <Label Grid.Row="0" Content="{Binding ReportTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" FontWeight="Bold"  BorderThickness="0"/>
        <Image Grid.Row="0" Source="/Resources/Company_GT.png" HorizontalAlignment="Left" Width="70" Margin="16,0,0,0"/>
        <Image Grid.Row="0" Source="{Binding SerialNoQrCode}" HorizontalAlignment="Right" Width="70" Margin="0,0,16,0"/>
        <!--测试信息-->
        <Grid Grid.Row="1" Margin="15,5,15,15" >
            <!--定义了3行-->
            <Grid.RowDefinitions>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
            </Grid.RowDefinitions>
            <!--定义了5列-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80*"/>
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Serial No:" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="0" Padding="0" Margin="5,0,0,0" FontWeight="Bold"/>
            <Label Grid.Row="0" Grid.Column="1" Content="{Binding SerialNo}" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="0" Padding="0" Margin="5,0,0,0"/>
            <Label Grid.Row="0" Grid.Column="2"  Content="Test Condition:" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="0" Padding="0" Margin="5,0,0,0" FontWeight="Bold"/>
            <Label Grid.Row="0" Grid.Column="3" Content="{Binding TestRoutine}" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="0" Padding="0" Margin="5,0,0,0"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Part No:" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="0" Padding="0" Margin="5,0,0,0" FontWeight="Bold"/>
            <Label Grid.Row="1" Grid.Column="1" Content="{Binding PartNo}" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="0" Padding="0" Margin="5,0,0,0"/>
            <Label Grid.Row="1" Grid.Column="2"  Content="Test Time :" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="0" Padding="0" Margin="5,0,0,0" FontWeight="Bold"/>
            <Label Grid.Row="1" Grid.Column="3" Content="{Binding TestDate}" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="0" Padding="0" Margin="5,0,0,0"/>

            <Border Grid.Row="0" Grid.Column="0" BorderThickness="1 1 1 1" BorderBrush="Black"/>
            <Border Grid.Row="0" Grid.Column="1" BorderThickness="1 1 1 1" BorderBrush="Black"/>
            <Border Grid.Row="0" Grid.Column="2" BorderThickness="1 1 1 1" BorderBrush="Black"/>
            <Border Grid.Row="0" Grid.Column="3" BorderThickness="1 1 1 1" BorderBrush="Black"/>
            <Border Grid.Row="1" Grid.Column="0" BorderThickness="1 1 1 1" BorderBrush="Black"/>
            <Border Grid.Row="1" Grid.Column="1" BorderThickness="1 1 1 1" BorderBrush="Black"/>
            <Border Grid.Row="1" Grid.Column="2" BorderThickness="1 1 1 1" BorderBrush="Black"/>
            <Border Grid.Row="1" Grid.Column="3" BorderThickness="1 1 1 1" BorderBrush="Black"/>
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Grid.RowSpan="2" BorderThickness="2 2 2 2" BorderBrush="Black"/>
        </Grid>
        <!--LIV数据-->
        <Grid Grid.Row="2" Margin="20,10,20,10">
            <!--定义了2列-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150*"/>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>
            <!--LIV图-->
            <lvc:CartesianChart AxisY="{Binding LivAxesY}"  Grid.Column="0" Margin="5,15,5,5" lvc:DisableAnimations="True" Series="{Binding LivSeries}"  DataTooltip="{Binding LivToolTip}" LegendLocation="None" UpdaterTickCommand="{Binding LivUpdaterTickCommand}">
                <!--X坐标轴-->
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis  Title="Current(A)" MinValue="0" MaxValue="{Binding LivChartCurrentStop}"  LabelFormatter="{Binding Formatter}" Foreground="Black" FontSize="14">
                        <lvc:Axis.Separator>
                            <lvc:Separator IsEnabled="True" Step="{Binding LivChartCurrentStep}" StrokeThickness="1" Stroke="Transparent"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>
            </lvc:CartesianChart>
            <TextBlock Text="{Binding LivChartTitle}"  VerticalAlignment="Top" HorizontalAlignment="Center"/>
            <!--参数列表-->
            <DataGrid Name="dataGridLivLimit" Grid.Column="2" Background="Transparent" AutoGenerateColumns="False" ItemsSource="{Binding LivTestResultData}" CanUserSortColumns="False" Style="{StaticResource BaseStyle}"
                                          BorderBrush="Transparent" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent" RowHeight="25" HeadersVisibility="Column" ColumnHeaderHeight="25" Padding="1" Margin="5,0,5,5">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="Black" />
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <TextBlock TextAlignment="Center" VerticalAlignment="Center">
                                                            <ContentPresenter  />
                                    </TextBlock>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <!--<DataGridTextColumn Header="序号" Width="50*" IsReadOnly="True" Binding="{Binding Id}"/>-->
                    <DataGridTextColumn Header="LIV Params" Width="80*" IsReadOnly="True" Binding="{Binding ParamName}"/>
                    <!--<DataGridTextColumn Header="下限" Width="70*" IsReadOnly="True" Binding="{Binding ParamMin}"/>
                                        <DataGridTextColumn Header="上限" Width="70*" IsReadOnly="True" Binding="{Binding ParamMax}"/>-->
                    <DataGridTextColumn Header="Value" Width="50*" IsReadOnly="True" Binding="{Binding TestValue}"/>
                    <!--<DataGridTextColumn Header="结果" Width="50*" IsReadOnly="True" Binding="{Binding TestResult}"/>-->
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!--SP数据-->
        <Grid Grid.Row="3" Margin="20,10,20,20">
            <!--定义了2列-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150*"/>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>
            <!--光谱图-->
            <lvc:CartesianChart  Grid.Column="0" Margin="5,20,5,5" lvc:DisableAnimations="True" Series="{Binding SpectrumSeries}" DataTooltip="{Binding SpToolTip}" LegendLocation="None" UpdaterTickCommand="{Binding SpUpdaterTickCommand}">
                <!--X坐标轴-->
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Title="Wavelength(nm)" MinValue="{Binding SpChartWavelengthLCL}" MaxValue="{Binding SpChartWavelengthUCL}" LabelFormatter="{Binding Formatter}" Foreground="Black" FontSize="14">
                        <lvc:Axis.Separator>
                            <lvc:Separator IsEnabled="True" Step="{Binding SpChartWavelengthStep}" StrokeThickness="1" Stroke="Transparent"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>
                <!--Y坐标轴-->
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis  Title="Intensity" MinValue="0" MaxValue="{Binding SpChartSpectrumUCL}" LabelFormatter="{Binding Formatter}" Foreground="Black" FontSize="14">
                        <lvc:Axis.Separator>
                            <lvc:Separator IsEnabled="True" Step="{Binding SpChartSpectrumStep}" StrokeThickness="1"  Stroke="Transparent"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
            <TextBlock Text="{Binding SpChartTitle}" VerticalAlignment="Top" HorizontalAlignment="Center"/>
            <!--参数列表-->
            <DataGrid Name="dataGridSpLimit" Grid.Column="2" Background="Transparent" AutoGenerateColumns="False" ItemsSource="{Binding SpTestResultData}" CanUserSortColumns="False" Style="{StaticResource BaseStyle}"
                                          BorderBrush="Transparent" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent" RowHeight="25" HeadersVisibility="Column" ColumnHeaderHeight="25" Padding="1" Margin="5,0,5,5">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <TextBlock TextAlignment="Center" VerticalAlignment="Center">
                                                            <ContentPresenter  />
                                    </TextBlock>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <!--<DataGridTextColumn Header="序号" Width="50*" IsReadOnly="True" Binding="{Binding Id}"/>-->
                    <DataGridTextColumn Header="Spectrum Params" Width="80*" IsReadOnly="True" Binding="{Binding ParamName}"/>
                    <!--<DataGridTextColumn Header="下限" Width="70*" IsReadOnly="True" Binding="{Binding ParamMin}"/>
                                        <DataGridTextColumn Header="上限" Width="70*" IsReadOnly="True" Binding="{Binding ParamMax}"/>-->
                    <DataGridTextColumn Header="Value" Width="50*" IsReadOnly="True" Binding="{Binding TestValue}"/>
                    <!--<DataGridTextColumn Header="结果" Width="50*" IsReadOnly="True" Binding="{Binding TestResult}"/>-->
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</FixedPage>